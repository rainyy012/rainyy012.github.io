{
  "name": "rains-blog",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "c": "node ./scripts/create-blog-post.ts",
    "docusaurus": "docusaurus",
    "start": "cross-env HTTPS=true SSL_CRT_FILE=localhost.pem SSL_KEY_FILE=localhost-key.pem docusaurus start --no-open",
    "lint": "eslint .",
    "test": "jest -c jest.config.ts",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "predeploy": "node ./scripts/check-deployment-env.ts",
    "deploy": "docusaurus deploy",
    "deploy-local": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "cross-env HTTPS=true SSL_CRT_FILE=localhost.pem SSL_KEY_FILE=localhost-key.pem docusaurus serve --no-open",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "spellcheck": "cspell lint . -c ./.vscode/cspell.json",
    "typecheck": "tsc",
    "inspect": "node ./scripts/inspect.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/plugin-client-redirects": "^3.10.1",
    "@docusaurus/plugin-content-blog": "^3.10.1",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-common": "^3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@glyph-cat/type-checking": "^1.1.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "cspell": "^10.3.6",
    "dotenv": "^18.0.7",
    "immer": "^11.1.21",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "react-share": "^6.1.0",
    "react-toastify": "^11.1.0",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "^3.10.1",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@eslint/js": "^10.0.1",
    "@glyph-cat/eslint-config": "1.0.1-alpha.15",
    "@jest/types": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0"
  }
}
